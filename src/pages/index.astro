---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { isPublishedArticle } from "../utils/articles";

const gitHubUrl = "https://github.com/PianoFitness/app";
const baseUrl = import.meta.env.BASE_URL || "/";

const title = "Piano Fitness — Structured Piano Practice";
const description =
  "An open-source, MIDI-aware piano practice app for making technical practice visible, structured, and easier to continue.";

const recentArticles = (await getCollection("articles"))
  .filter(isPublishedArticle)
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  )
  .slice(0, 3);
---

<Layout title={title} description={description}>
  <section class="hero bg-base-200 py-16 md:py-24">
    <div class="container mx-auto px-4 text-center">
      <img
        src={baseUrl + "PianoFitness.png"}
        alt="Piano Fitness logo"
        class="w-32 h-32 mx-auto mb-6 rounded-[20%] shadow-lg"
      />
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        Structured piano practice, made visible
      </h1>
      <p class="text-xl mb-8 max-w-2xl mx-auto">
        Piano Fitness is an open-source, MIDI-aware practice app for technical
        patterns, foundational harmony, and consistent practice.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href={gitHubUrl} class="btn btn-primary">Follow development on GitHub</a>
        <a href={baseUrl + "#features"} class="btn btn-outline">Explore the app</a>
      </div>
    </div>
  </section>

  <section id="features" class="py-16">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">Practice with a clear focus</h2>
        <p class="text-lg max-w-2xl mx-auto">
          Piano Fitness is built to support lessons, self-directed learning, and
          regular time at the keyboard.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
          <div class="card-body items-center text-center">
            <div class="text-4xl mb-4">🎹</div>
            <h3 class="card-title text-xl mb-2">Structured exercises</h3>
            <p>
              Work through scales, arpeggios, chords, progressions, cadences,
              and other foundational musical patterns.
            </p>
          </div>
        </div>

        <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
          <div class="card-body items-center text-center">
            <div class="text-4xl mb-4">🎯</div>
            <h3 class="card-title text-xl mb-2">Feedback you can use</h3>
            <p>
              Connect a MIDI keyboard to see the notes to play and receive
              feedback on completion, accuracy, and tempo.
            </p>
          </div>
        </div>

        <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
          <div class="card-body items-center text-center">
            <div class="text-4xl mb-4">📈</div>
            <h3 class="card-title text-xl mb-2">Practice you can revisit</h3>
            <p>
              Keep local practice history, use profiles, and practise with a
              built-in metronome as you develop each skill.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="py-16 bg-base-200">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4">A companion for deliberate practice</h2>
        <p class="text-lg max-w-2xl mx-auto">
          The app helps make musical patterns concrete under your hands. It does
          not replace a teacher or assess physical hand posture.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h3 class="card-title text-xl">Choose a focus</h3>
            <p>
              Select an exercise, key, hand, and other settings that match the
              skill you want to practise.
            </p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h3 class="card-title text-xl">Play and observe</h3>
            <p>
              Use the visual piano and MIDI input to work through the expected
              notes at a manageable tempo.
            </p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h3 class="card-title text-xl">Continue from evidence</h3>
            <p>
              Review completed exercises and use the results to decide what to
              repeat or explore next.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="status" class="py-16">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body text-center items-center">
          <h2 class="card-title text-3xl mb-3">The next iPad release is in preparation</h2>
          <p class="text-lg max-w-2xl">
            Piano Fitness is being prepared for a refreshed public release. The
            project is developed in public, and the source code is available now
            for people who want to follow or contribute.
          </p>
          <div class="card-actions mt-4">
            <a href={gitHubUrl} class="btn btn-primary">View the project on GitHub</a>
            <a href={baseUrl + "mission"} class="btn btn-outline">Read our mission</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    recentArticles.length > 0 && (
      <section class="py-16 bg-base-200">
        <div class="container mx-auto px-4">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold mb-4">Latest articles</h2>
            <p class="text-lg max-w-2xl mx-auto">
              Notes on piano practice, harmony, and the development of Piano
              Fitness.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {recentArticles.map((article) => {
              const { title, description, publishDate, tags } = article.data;
              const formattedDate = publishDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              });

              return (
                <article class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
                  <div class="card-body">
                    <h3 class="card-title text-lg">
                      <a href={`${baseUrl}articles/${article.slug}`} class="text-primary hover:text-primary/80 transition-colors">
                        {title}
                      </a>
                    </h3>
                    {description && <p class="text-neutral-content/70 text-sm mb-3">{description}</p>}
                    <div class="flex flex-wrap items-center justify-between gap-2 mt-auto">
                      <time class="text-xs text-neutral-content/60">{formattedDate}</time>
                      {tags && tags.length > 0 && (
                        <div class="flex flex-wrap gap-1">
                          {tags.slice(0, 2).map((tag) => <span class="badge badge-secondary badge-xs">{tag}</span>)}
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
          <div class="text-center mt-8"><a href={`${baseUrl}articles`} class="btn btn-outline">View all articles</a></div>
        </div>
      </section>
    )
  }

  <section class="py-16 bg-primary text-primary-content">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Follow the next release</h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto">
        Explore the open-source project, follow development, or contribute to
        Piano Fitness.
      </p>
      <a href={gitHubUrl} class="btn btn-accent text-accent-content hover:btn-accent-focus">View on GitHub</a>
    </div>
  </section>
</Layout>
