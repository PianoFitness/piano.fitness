---
import Layout from './Layout.astro';
import Prose from '../components/Prose.astro';

const { frontmatter } = Astro.props;
const {
  title,
  description,
  image = import.meta.env.BASE_URL + "PianoFitness.png",
  type = "article"
} = frontmatter;
const gitHubUrl = "https://github.com/PianoFitness/app";
---

<Layout title={title} description={description} image={image} type={type}>
  <div class="container mx-auto px-4 py-8 md:py-16 max-w-4xl">
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-2">{frontmatter.title}</h1>
      {frontmatter.description && <p class="text-neutral-content/70">{frontmatter.description}</p>}
    </div>
    <div class="bg-base-100 dark:bg-neutral-900 p-6 md:p-8 rounded-lg shadow-md">
      <Prose><slot /></Prose>
      <div class="mt-8 pt-6 border-t border-base-300 text-center">
        <p class="mb-3">Piano Fitness is developed in public.</p>
        <a href={gitHubUrl} class="btn btn-primary">Follow the project on GitHub</a>
      </div>
    </div>
  </div>
</Layout>
