---
import { Icon } from "astro-icon/components";

const gitHubUrl = "https://github.com/PianoFitness/app";
const gitHubIssuesUrl = `${gitHubUrl}/issues`;
const gitHubLicenseUrl = `${gitHubUrl}/blob/main/LICENSE`;
const baseUrl = import.meta.env.BASE_URL || "/";
---

<footer class="footer p-10 bg-neutral text-neutral-content">
  <div class="container mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 w-full">
      <div class="space-y-4">
        <div class="flex items-center gap-4">
          <img src={baseUrl + "PianoFitness.png"} alt="Piano Fitness logo" class="w-16 h-16 rounded-[20%] flex-shrink-0" />
          <p>Piano Fitness is an open-source tool for structured piano practice and foundational harmony.</p>
        </div>
      </div>
      <div class="space-y-4">
        <span class="footer-title">Project</span>
        <nav class="flex flex-col space-y-2">
          <a href={gitHubUrl} class="link link-hover flex items-center gap-2 group"><Icon name="mdi:github" size={16} class="text-accent group-hover:text-accent-focus transition-colors" />Follow development</a>
          <a href={baseUrl + "#status"} class="link link-hover">Release status</a>
        </nav>
        <span class="footer-title">About</span>
        <nav class="flex flex-col space-y-2">
          <a href={baseUrl + "mission"} class="link link-hover">Our mission</a>
          <a href={baseUrl + "team"} class="link link-hover">Development team</a>
        </nav>
      </div>
      <div class="space-y-4">
        <span class="footer-title">Resources</span>
        <nav class="flex flex-col space-y-2">
          <a href={baseUrl + "articles"} class="link link-hover">Articles</a>
          <a href={baseUrl + "rss.xml"} class="link link-hover flex items-center gap-2 group"><Icon name="mdi:rss" size={16} class="text-accent group-hover:text-accent-focus transition-colors" />RSS feed</a>
          <a href={gitHubIssuesUrl} class="link link-hover">Report an issue</a>
          <a href={gitHubLicenseUrl} class="link link-hover">License</a>
        </nav>
      </div>
      <div class="space-y-4">
        <span class="footer-title">Legal</span>
        <nav class="flex flex-col space-y-2">
          <a href={baseUrl + "privacy"} class="link link-hover">Privacy policy</a>
          <a href={baseUrl + "terms"} class="link link-hover">Terms of use</a>
        </nav>
      </div>
    </div>
  </div>
</footer>

<footer class="footer footer-center p-4 bg-neutral text-neutral-content">
  <div><p>&copy; 2026 Piano Fitness. All rights reserved.</p></div>
</footer>
